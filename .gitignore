# ---- Python bytecode & cache ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.dll

# ---- Virtual envs ----
.venv/
venv/
env/

# ---- Packaging / build ----
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# ---- Test / Lint caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE / OS ----
.vscode/
*.code-workspace
.idea/
.DS_Store
Thumbs.db

# ---- Env / tooling ----
.env
.env.*
.python-version

# ---- Project data & outputs ----
# (garde un .gitkeep si tu veux versionner les dossiers vides)
data/outputs/
data_outputs/
!data/outputs/.gitkeep
!data_outputs/.gitkeep

# Optionnel: si tu ne veux PAS versionner les samples générées
# data/samples/*.jpg
# data/samples/*.png

# ---- Models & large binaries ----
models/*.h5
models/*.hdf5
models/*.keras
models/*.ckpt
models/*.tflite
models/*.onnx
models/*.pb
models/checkpoints/
!models/.gitkeep

# ---- Logs / debug ----
logs/
*.log
data/outputs/debug/
!data/outputs/debug/.gitkeep

# ---- Temporary files ----
*.tmp
*.temp
*.swp
*.swo

# ---- Images de résultats courants ----
result.jpg
result.png
